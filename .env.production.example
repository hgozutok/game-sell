# ===== VPS uretim ortami =====
# Kullanim: bu dosyayi .env.production olarak kopyala, degerleri doldur.
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Veritabani ---
POSTGRES_USER=medusa
POSTGRES_PASSWORD=degistir_beni
POSTGRES_DB=medusa-digital-store

# --- Guvenlik sirlari (openssl rand -base64 32 ile uret) ---
JWT_SECRET=degistir_beni_openssl_rand_base64_32
COOKIE_SECRET=degistir_beni_openssl_rand_base64_32

# Dijital anahtarlarin DB'de sifrelenmesi icin (openssl rand -hex 32)
DIGITAL_KEY_ENCRYPTION_KEY=degistir_beni_openssl_rand_hex_32

# --- Kinguin ---
KINGUIN_API_KEY=kinguin_api_anahtarin
KINGUIN_BASE_URL=https://api.kinguin.net
# readonly: otomatik Kinguin siparisi yok (admin onayi) | live: otomatik
KINGUIN_ORDER_MODE=readonly

# --- Public URL'ler (VPS domain'ine gore duzenle) ---
# Tarayicinin baglanacagi backend adresi (storefront BUILD arg'i)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.senindomain.com
# Canonical/sitemap URL'leri icin public site adresi
NEXT_PUBLIC_SITE_URL=https://senindomain.com
# Backend'e bildirilen CORS kaynaklari
MEDUSA_BACKEND_URL=https://api.senindomain.com
STORE_CORS=https://senindomain.com
ADMIN_CORS=https://senindomain.com,https://admin.senindomain.com
AUTH_CORS=https://api.senindomain.com,https://senindomain.com

# --- Publishable key ---
# Ilk calistirmadan sonra admin panelde olusturup buraya yaz ve storefront'u
# yeniden build et (build arg olarak client bundle'ina islenir).
NEXT_PUBLIC_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxx

# --- Opsiyonel odeme / e-posta ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
MOLLIE_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Port eslemeleri (reverse proxy yoksa) ---
BACKEND_PORT=9000
STOREFRONT_PORT=3000
