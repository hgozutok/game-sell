# ===== VPS uretim ortami =====
# Kullanim: bu dosyayi .env.production olarak kopyala, degerleri doldur.
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production up -d --build

# --- Veritabani ---
# Veri ./db-data/postgres altinda tutulur (proje klasoru ile birlikte tasinir).
POSTGRES_USER=medusa
POSTGRES_PASSWORD=degistir_beni
POSTGRES_DB=medusa-digital-store

# --- Guvenlik sirlari (openssl rand -base64 32 ile uret) ---
JWT_SECRET=degistir_beni_openssl_rand_base64_32
COOKIE_SECRET=degistir_beni_openssl_rand_base64_32

# Dijital anahtarlarin DB'de sifrelenmesi icin (openssl rand -hex 32)
DIGITAL_KEY_ENCRYPTION_KEY=degistir_beni_openssl_rand_hex_32

# --- Kinguin ---
KINGUIN_API_KEY=kinguin_api_anahtarin
# ESA API gateway. api.kinguin.net eski/yanlis host (401 invalid authentication).
KINGUIN_BASE_URL=https://gateway.kinguin.net/esa/api
# readonly: otomatik Kinguin siparisi yok (admin onayi) | live: otomatik
KINGUIN_ORDER_MODE=readonly

# --- Public URL'ler (VPS domain'ine gore duzenle) ---
# Tarayicinin baglanacagi backend adresi (storefront BUILD arg'i)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.hupiplay.uk
# Canonical/sitemap URL'leri icin public site adresi
NEXT_PUBLIC_SITE_URL=https://hupiplay.uk
# Backend'e bildirilen CORS kaynaklari (virgulle ayrilmis, tam origin)
MEDUSA_BACKEND_URL=https://api.hupiplay.uk
STORE_CORS=https://hupiplay.uk,https://www.hupiplay.uk,http://localhost:13000,http://localhost:13100
ADMIN_CORS=https://hupiplay.uk,https://www.hupiplay.uk,http://localhost:13000,http://localhost:13100
AUTH_CORS=https://hupiplay.uk,https://www.hupiplay.uk,http://localhost:13000,http://localhost:13100

# --- Publishable key ---
# Ilk calistirmadan sonra admin panelde olusturup buraya yaz ve storefront'u
# yeniden build et (build arg olarak client bundle'ina islenir).
NEXT_PUBLIC_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxx

# --- Opsiyonel odeme ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
PAYPAL_WEBHOOK_ID=
MOLLIE_API_KEY=
MOLLIE_ENABLED=false

# --- E-posta / SMTP ---
# Kayit dogrulama, sifre sifirlama, siparis ve iletisim e-postalari bu SMTP ile
# gonderilir. Panelden (Magaza -> E-posta Ayarlari) kaydedilen deger burada
# yazilani ezer; ikisini birden kullanmak zorunda degilsiniz.
#
# Saglayici ornekleri:
#   Brevo   : SMTP_HOST=smtp-relay.brevo.com    SMTP_PORT=587 SMTP_SECURE=false
#   Resend  : SMTP_HOST=smtp.resend.com         SMTP_PORT=587 SMTP_SECURE=false
#   Postmark: SMTP_HOST=smtp.postmarkapp.com    SMTP_PORT=587 SMTP_SECURE=false
#   Mailgun : SMTP_HOST=smtp.mailgun.org        SMTP_PORT=587 SMTP_SECURE=false
#   SES     : SMTP_HOST=email-smtp.eu-west-1.amazonaws.com SMTP_PORT=465 SMTP_SECURE=true
#
# SMTP kullanici adi genelde saglayicinin API anahtari/parolasidir.
# Gonderici alan adinin SPF/DKIM kayitlari saglayicida dogrulanmalidir.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@hupiplay.uk
SMTP_FROM_NAME=HUPIPLAY
# Self-signed SMTP sertifikasi kullaniyorsaniz false yapin (oncelikle duzeltin)
SMTP_TLS_REJECT_UNAUTHORIZED=true

# HTTPS arkasinda cerezler Secure gonderilir. TLS sonlandirmasi yoksa false yapin.
COOKIE_SECURE=true

# --- Port eslemeleri (reverse proxy yoksa) ---
BACKEND_PORT=13100
STOREFRONT_PORT=13000
