# ============ Core ============
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-store
REDIS_URL=redis://:@localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
MEDUSA_BACKEND_URL=http://localhost:9000
WORKER_MODE=shared # shared | server | worker

STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:3000,http://localhost:7001,http://localhost:7000
AUTH_CORS=http://localhost:3000,http://localhost:7001,http://localhost:7000

# ============ Kinguin ESA API ============
# https://www.kinguin.net/dev-portal — Dashboard > MY STORES altindan API key
# Production: https://gateway.kinguin.net/esa/api
# Sandbox (varsayim, resmi dokumanda base URL yayinlanmiyor): https://gateway.sandbox.kinguin.net/esa/api
KINGUIN_API_KEY=your_kinguin_api_key
KINGUIN_BASE_URL=https://gateway.kinguin.net/esa/api
# readonly: hicbir Kinguin siparisi olusturulmaz (fulfillment manuel kuyruga duser)
# live: odenen siparişler icin gercek Kinguin siparisi olusturulur (PARA HARCAR)
KINGUIN_ORDER_MODE=readonly
# Webhook imza dogrulamasi icin gizli anahtar (Kinguin dashboard'da tanimlanir)
KINGUIN_WEBHOOK_SECRET=change-me-kinguin-webhook-secret
# Kinguin katalog fiyati EUR; mağaza USD bazli
KINGUIN_PROVIDER_CURRENCY=eur

# ============ Key sifreleme ============
# AES-256-GCM anahtari — uretim: openssl rand -hex 32
DIGITAL_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============ Fulfillment ============
FULFILL_MAX_RETRIES=4

# ============ CodesWholesale (opsiyonel ikinci saglayici) ============
CODESWHOLESALE_CLIENT_ID=
CODESWHOLESALE_CLIENT_SECRET=
CODESWHOLESALE_API_URL=https://api.codeswholesale.com

# ============ Odeme saglayicilari ============
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
MOLLIE_API_KEY=test_...
MOLLIE_WEBHOOK_URL=

# ============ E-posta ============
# Bos ise dev fallback logger kullanilir (mail gitmez, loga yazilir)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=orders@example.com
